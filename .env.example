# Copie para `.env` (dev local) ou configure como env vars no Railway. Nenhum
# valor real deve ir neste arquivo — só nomes e exemplos.

# Postgres (Railway, rede privada) — ver src/shared/lib/db.ts
DATABASE_URL=postgres://user:password@host:5432/database

# URL pública e canônica desta aplicação — usada em metadata/canonical/
# sitemap/robots/JSON-LD (ver src/shared/config/site.ts). Domínio oficial já
# adquirido; se a env var for omitida, cai neste mesmo valor por padrão.
# NÃO apontar para o domínio do Railway nem para o antigo da Vercel — ambos
# são só ambiente técnico, nunca a identidade canônica (ROADMAP.md, ADR-015).
NEXT_PUBLIC_SITE_URL=https://babyavancar.com.br
