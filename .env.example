# Copie para `.env` (dev local) ou configure como env vars no Railway. Nenhum
# valor real deve ir neste arquivo — só nomes e exemplos.

# Postgres (Railway, rede privada) — ver src/shared/lib/db.ts
DATABASE_URL=postgres://user:password@host:5432/database

# URL pública desta aplicação — usada em metadata/canonical/sitemap/robots
# (ver src/shared/config/site.ts). Sem domínio próprio ainda: se omitida, cai
# no fallback já validado em produção no Railway (ROADMAP.md, ADR-012/013).
NEXT_PUBLIC_SITE_URL=https://baby-avancar-production.up.railway.app
